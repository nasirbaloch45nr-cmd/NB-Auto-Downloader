{
  "manifest_version": 3,
  "name": "NB Auto Downloader",
  "version": "1.2",
  "description": "Custom lightweight auto downloader with full height sidepanel UI.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Open NB Auto Downloader"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"]
    }
  ]
}
