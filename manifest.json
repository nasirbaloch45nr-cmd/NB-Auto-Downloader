{
  "manifest_version": 3,
  "name": "NB Auto Downloader",
  "version": "1.4",
  "description": "Custom lightweight auto downloader with full height sidepanel UI.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open NB Downloader"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
